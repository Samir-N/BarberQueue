      },
      "bodyLarge": {
        "size": "16px",
        "weight": "400",
        "lineHeight": "1.5"
      },
      "body": {
        "size": "14px",
        "weight": "400",
        "lineHeight": "1.5"
      },
      "caption": {
        "size": "12px",
        "weight": "400",
        "lineHeight": "1.4"
      }
    }
